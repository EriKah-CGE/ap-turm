<nav class="sheet-tabs tabs apt-tabs" data-group="primary" aria-roledescription="{{localize "SHEETS.FormNavLabel"}}">
  {{#each tabs as |tab|}}
  <a data-action="tab" data-group="{{tab.group}}" data-tab="{{tab.id}}" class="{{tab.cssClass}}"><span>{{tab.label}}</span>{{#if tab.pending}}<i class="fa-solid fa-triangle-exclamation apt-tab-open" title="{{tab.pendingHint}}"></i>{{/if}}</a>
  {{/each}}
</nav>
