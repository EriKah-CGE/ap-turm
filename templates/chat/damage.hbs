<div class="ap-turm-chat apt-card apt-damage {{#if crit}}crit{{/if}}">
  <header class="apt-card-h"><i class="fa-solid fa-burst"></i> <b>{{weapon}}</b> <span class="sub">Damage{{#if crit}} · Critical{{#if critMax}} (max){{/if}}{{/if}}</span></header>
  <div class="apt-card-total"><span class="tot">{{total}}</span><span class="dt" style="{{#if dtypeColor}}color:{{dtypeColor}}{{/if}}">{{dtype}}</span></div>
  <table class="apt-card-table">
    {{#each parts}}
    <tr><td class="lbl">{{label}}{{#if @root.multiType}} <span class="dt" style="{{#if color}}color:{{color}}{{/if}}">{{type}}</span>{{/if}}</td><td class="f">{{formula}}{{#if critText}} <span class="critx">{{critText}}</span>{{/if}}</td><td class="num">{{sum}}</td></tr>
    {{/each}}
  </table>
  {{#if target}}
  <div class="apt-card-target apt-card-def">
    <b>{{{target.nameHtml}}}</b>
    <span class="chips">{{#each target.chips}}<span class="tag def {{#if hit}}hit{{/if}} {{#if unassigned}}unassigned{{/if}}" style="{{#if color}}--el:{{color}}{{/if}}"><small>{{abbr}}</small> {{label}}</span>{{else}}<span class="none">no resistances</span>{{/each}}</span>
    {{#if target.multi}}
    <span class="lines">{{#each target.lines}}<span class="mult {{#if (eq mult 1)}}{{else}}act{{/if}}"><span style="{{#if color}}color:{{color}}{{/if}}">{{type}}</span> {{amount}} {{label}}{{#if reason}} ({{reason}}){{/if}} = {{taken}}</span>{{/each}}</span>
    <span class="mult {{#if target.act}}act{{/if}}">Total {{target.taken}}</span>
    {{else}}
    <span class="mult {{#if (eq target.mult 1)}}{{else}}act{{/if}}">{{target.label}}{{#if target.reason}} ({{target.reason}}){{/if}}</span>
    {{/if}}
  </div>
  {{/if}}
  {{#each warnings}}<div class="apt-card-warn">{{this}}</div>{{/each}}
  <div class="apt-card-actions"><button type="button" data-action="applyDamage"><i class="fa-solid fa-heart-crack"></i> Apply to target</button></div>
</div>
