<div class="apt-jb-libhead">
  <div class="apt-addrow">
    <button type="button" class="apt-add" data-action="newPlaylist"><i class="fa-solid fa-plus"></i> New playlist</button>
    <button type="button" class="apt-add" data-action="importFolder" title="A folder inside Foundry's data folder"><i class="fa-solid fa-folder-open"></i> Import folder as playlist</button>
    <button type="button" class="apt-add" data-action="importComputer" title="A folder or files from anywhere on this computer (uploaded into Data/music)"><i class="fa-solid fa-upload"></i> Import from computer</button>
  </div>
  <p class="hint apt-jb-drophint"><i class="fa-solid fa-file-audio"></i> Drop audio files or a folder from your computer on this window to import them.</p>
  <label class="apt-jb-searchbox"><i class="fa-solid fa-magnifying-glass"></i><input type="search" class="apt-jb-search" placeholder="Search playlists and tracks" value="{{query}}" autocomplete="off"></label>
</div>
